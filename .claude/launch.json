{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "securevault",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "port": 3443,
      "url": "https://localhost:3443"
    },
    {
      "name": "securevault-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "client"
      ],
      "port": 5173
    }
  ]
}